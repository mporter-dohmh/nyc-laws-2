			<RECORD id="0-0-0-246030" number="50775" version="2507">
				<PARA>
					<PARAFORMAT justify="center">(Am. L.L. 2026/115, 7/11/2026, eff. 7/11/2026) <HIGHLIGHTER style="ALP" style-name-escaped="ALP" name="ALP" id="0-0-0-25">[ALP S-123]</HIGHLIGHTER>
					</PARAFORMAT>
				</PARA>
